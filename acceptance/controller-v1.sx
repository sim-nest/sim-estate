(sim.estate-controller-acceptance-manifest/v1
  (case (id "controller-capability") (category "resource/controller"))
  (case (id "fixed-inventory") (category "provider/discovery"))
  (case (id "delivered-provider") (category "provider/ansible-site"))
  (case (id "organ-apply") (category "organ/plan-review-apply"))
  (case (id "process-attempt") (category "process/attempt"))
  (case (id "durable-book") (category "book/projection"))
  (case (id "table-projection") (category "table/read-only-view"))
  (case (id "cli-output") (category "serve/history-output"))
  (case (id "refusal") (category "model/not-dispatched"))
  (case (id "controller-loss") (category "model/quarantine"))
  (case (id "project-equivalence") (category "project/before-after"))
  (case (id "private-boundary") (category "evidence/sanitized"))
  (case (id "offline-verifier") (category "artifact/verify"))
)
